# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=            # 강사가 나눠 준 Claude 키 (절대 GitHub·카톡 공개방에 올리지 말 것)

# 찻집 찾기 Python 도구(jeju_tea_tools.py)용 — 이 파일을 .env 로 복사해서 채우세요
KAKAO_REST_API_KEY=           # 카카오 디벨로퍼스 > 내 애플리케이션 > REST API 키
NAVER_CLIENT_ID=              # 네이버 개발자센터 > 애플리케이션 > Client ID (검색 API 추가 필요)
NAVER_CLIENT_SECRET=          # 같은 곳의 Client Secret
